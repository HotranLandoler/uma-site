---
import GameCard from "./GameCard.astro";
import youchatBanner from "../assets/games/YouchatBanner.avif";
import crashPunkBanner from "../assets/games/CrashPunkBanner.jpg";
import poopyBirdBanner from "../assets/games/PoopyBirdBanner.jpg";
---

<section class="mb-12">
  <hgroup class="mb-4">
    <h2 class="text-2xl font-bold">代表作品</h2>
    <p class="text-lg font-bold" lang="en">Featured Products</p>
  </hgroup>

  <ul class="flex flex-col gap-4">
    <li>
      <GameCard href="https://www.gcores.com/games/174049" src={youchatBanner} alt="Youchat.exe" title="Youchat.exe by UMa Studio" />
    </li>
    <li>
      <GameCard href="https://www.gcores.com/games/130910" src={crashPunkBanner} alt="Crash Punk" title="Crash Punk by UMa Studio" />
    </li>
    <li>
      <GameCard href="https://www.gcores.com/games/174048" src={poopyBirdBanner} alt="Poopy Bird" title="Poopy Bird by UMa Studio" />
    </li>
  </ul>
</section>
