---
import { Image } from "astro:assets";
import itchIoLogo from "../assets/social/itchio.png";
import mail from "../assets/social/mail.svg";
import xiaohongshu from "../assets/social/xiaohongshu.svg";
import bilibili from "../assets/social/bilibili.png";

const socialLinks = [
  {
    name: "Xiaohongshu",
    href: "https://www.xiaohongshu.com/user/profile/6524c39e000000002a029247",
    icon: xiaohongshu,
  },
  {
    name: "itch.io",
    href: "https://itch.io/profile/uma-studio",
    icon: itchIoLogo,
  },
  {
    name: "Bilibili",
    href: "https://space.bilibili.com/3493083104676301",
    icon: bilibili,
  },
  {
    name: "Email",
    href: "mailto:contact@uma-studio.games",
    icon: mail,
  },
];
---

<ul class="flex items-center justify-center gap-2">
  {
    socialLinks.map(({ name, href, icon }) => (
      <li class="max-w-8">
        <a href={href} rel="noreferrer" target="_blank" title={`${name} Page`}>
          <Image src={icon} alt={`The logo of ${name}.`} />
        </a>
      </li>
    ))
  }
</ul>